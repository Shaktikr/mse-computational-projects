! =====================================================================================
!  Lesson 2: magnetism - spin-polarised SCF for ferromagnetic fcc Ni
!  New keywords: nspin, starting_magnetization. Compare the total energy and the
!  "total magnetization" line with a non-magnetic run (nspin = 1) - FM Ni is lower in energy.
! =====================================================================================
&CONTROL
   calculation = 'scf'
   prefix      = 'ni'
   outdir      = './tmp'
   pseudo_dir  = '../pseudo'
   tstress     = .true.
/
&SYSTEM
   ibrav       = 2
   celldm(1)   = 6.6519                  ! 3.52 A in bohr
   nat         = 1
   ntyp        = 1
   ecutwfc     = 45.0                    ! Ni 3d electrons are localised -> higher cut-off than Al
   ecutrho     = 360.0
   occupations = 'smearing'
   smearing    = 'mv'
   degauss     = 0.02
   nspin       = 2                       ! collinear spin polarisation (spin up / spin down)
   starting_magnetization(1) = 0.4       ! initial guess, fraction of valence charge (-1..1)
/
&ELECTRONS
   conv_thr    = 1.0d-9
   mixing_beta = 0.3
/
ATOMIC_SPECIES
   Ni  58.6934  Ni.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
   Ni  0.0  0.0  0.0
K_POINTS automatic
   18 18 18  0 0 0
