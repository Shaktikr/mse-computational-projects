&CONTROL
  calculation = 'scf'
  prefix = 'al'
  outdir = './tmp_k_20'
  pseudo_dir = '/home/claude/repro/pseudo'
  tstress = .true.
  tprnfor = .true.
  disk_io = 'low'
/
&SYSTEM
  ibrav = 0
  nat = 1
  ntyp = 1
  ecutwfc = 50
  ecutrho = 400
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0e-09
  mixing_beta = 0.5
/
ATOMIC_SPECIES
  Cu 63.546 Cu.pbe-dn-rrkjus_psl.0.2.UPF
CELL_PARAMETERS angstrom
  -1.8150000000  0.0000000000  1.8150000000
  0.0000000000  1.8150000000  1.8150000000
  -1.8150000000  1.8150000000  0.0000000000
ATOMIC_POSITIONS crystal
  Cu 0.0000000000  0.0000000000  0.0000000000
K_POINTS automatic
  20 20 20 0 0 0
